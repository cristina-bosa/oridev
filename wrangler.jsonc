{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oridev",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Dominio propio: Cloudflare crea el registro DNS y el certificado al
  // desplegar. La zona tiene que estar en la misma cuenta.
  "routes": [{ "pattern": "oriclux.dev", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Auto-referencia que usa OpenNext para la caché; debe coincidir con `name`.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "oridev",
    },
  ],
}
