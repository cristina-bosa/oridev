---
import ProjectsCarousel, {
  type Project,
} from "@/components/react/ProjectsCarousel.tsx";

const projects: Project[] = [
  {
    title: "NRG Consulting",
    tags: ["Develop", "UX/UI", "Design system"],
    description:
      "Página web corporativa de la empresa.",
    link: "https://www.nrgconsulting.com/",
    personal: false,
  },
  {
    title: "Seroil Gas Ahorro",
    tags: ["UX/UI", "Design system"],
    description:
      "Plataforma web que proporciona a los clientes la posibilidad de comparar sus facturas de gas con las ofertas disponibles de la distribuidora.",
    link: "https://seroilgasahorro.com/en",
    personal: false,
  },
    {
    title: "CAES",
    tags: ["Develop", "UX/UI"],
    description:
      "Plataforma web que permite la gestión de solicitudes para beneficiarios como intermediarios de Certificados de Ahorro de Energía (CAES) proporcionado por el MITECO.",
    link: "https://caes.digital/es",
    personal: false,
  },
  {
    title: "Triggers",
    tags: ["Develop", "UX/UI"],
    description:
      "Triggers es una aplicación multiplataforma que sirve para visualizar indicadores generados a partir de distintas commodities en tiempo real.",
    link: "#",
    personal: false,
  },
    {
    title: "Libri",
    tags: ["Develop", "UX/UI", "Design system"],
    description:
      "PWA que permite al usuario crear y gestionar su biblioteca personal.",
    link: "#",
    personal: true,
  },
];
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <div class="projects__intro">
    <h2 id="projects-title" class="projects__title">Projects</h2>
    <p class="projects__description">
      Lorem ipsum dolor sit, amet consectetur adipisicing elit. Harum qui, eos
      eius iusto unde quis deleniti soluta impedit corrupti non magni voluptatem
      obcaecati, cumque, sint natus iste amet voluptas error?
    </p>
  </div>

  {/* `client:visible` hidrata al acercarse a pantalla: el runtime de React
      no se descarga mientras el carrusel esté lejos. */}
  <ProjectsCarousel projects={projects} client:visible />
</section>

<style>
  @reference "@/styles/global.css";

  .projects {
    @apply flex flex-col justify-center w-full;
    @apply scroll-mt-20;
  }
  .projects__intro {
    @apply flex flex-col items-start gap-4 max-w-2xl;
  }
  .projects__title {
    @apply text-4xl font-bold text-ink;
  }
  .projects__description {
    @apply text-lg text-ink;
  }
</style>
