---
import ProjectsCarousel, {
  type Project,
} from "@/components/react/ProjectsCarousel.tsx";
import { projects as projectsData } from "@/data/projects";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);

const projects: Project[] = projectsData.map((project) => ({
  title: project.title,
  tags: project.tags.map((tag) => t.projects.tags[tag]),
  summary: t.projects.items[project.id].summary,
  description: t.projects.items[project.id].description,
  link: project.link,
  personal: project.personal,
  url_playstore: project.url_playstore,
  url_applestore: project.url_applestore,
}));

const labels = {
  carousel: t.projects.carouselLabel,
  personal: t.projects.personalBadge,
  closeDialog: t.projects.closeDialog,
};
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <div class="projects__intro">
    <h2 id="projects-title" class="projects__title">{t.projects.title}</h2>
    <p class="projects__description">{t.projects.description}</p>
  </div>

  <ProjectsCarousel projects={projects} labels={labels} client:visible />
</section>

<style>
  @reference "@/styles/global.css";

  .projects {
    @apply flex flex-col justify-center w-full;
    @apply scroll-mt-20;
  }
  .projects__intro {
    @apply flex flex-col items-start gap-4 max-w-2xl;
  }
  .projects__title {
    @apply text-3xl sm:text-4xl font-bold text-ink;
  }
  .projects__description {
    @apply text-base sm:text-lg text-ink;
  }
</style>
