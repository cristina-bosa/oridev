---
import ThemeToggle from "@/components/react/ThemeToggle.tsx";
---
<header class="header">
  <nav class="nav">
    <div class="nav__brand">
      <a href="/">oriclux</a>
    </div>

    <ul class="nav__menu">
      <li class="nav__menu__item"><a href="#projects">Projects</a></li>
      <li class="nav__menu__item"><a href="#experience">Experience</a></li>
      <li class="nav__menu__item"><a href="#skills">Skills</a></li>
      <li class="nav__menu__item"><a href="#contact">Contact</a></li>
      <li><ThemeToggle client:load /></li>
    </ul>
  </nav>
</header>

<style>
  @reference "@/styles/global.css";
  .header {
    @apply flex justify-center items-center w-full h-16;
    @apply sticky top-0 z-1;
    @apply border-b border-solid border-rule bg-transparent;
  }

  @supports (animation-timeline: scroll()) {
    .header {
    
      animation-name: header-blur;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-timeline: scroll(root block);
      animation-range: 0 80px;
    }
  }
  .nav {
    @apply flex justify-between items-center w-full;
    @apply container mx-auto;
  }
  .nav__brand {
    @apply font-bold text-ink;
  }
  .nav__menu {
    @apply flex gap-4;
    align-items: center;
  }
  .nav__menu__item {
    @apply text-ink;
    @apply hover:text-brand;
  }
    @keyframes header-blur {
    from {
      background-color: transparent;
      backdrop-filter: blur(0px);
    }
    to {
      background-color: color-mix(in oklab, var(--ui-background) 20%, transparent);
      backdrop-filter: blur(12px);
    }
  }
</style>
