---
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<section id="about-me" class="about-me" aria-labelledby="about-me-title">
  <div class="about-me__intro">
    <h2 id="about-me-title" class="about-me__title">{t.aboutMe.title}</h2>
    <p class="about-me__description">{t.aboutMe.description}</p>
  </div>
</section>

<style>
  @reference "@/styles/global.css";

  .about-me {
    @apply flex flex-col justify-center w-full;
    @apply scroll-mt-20;
  }
  .about-me__intro {
    @apply flex flex-col items-start gap-4 max-w-2xl;
  }
  .about-me__title {
    @apply text-3xl sm:text-4xl font-bold text-ink;
  }
  .about-me__description {
    @apply text-base sm:text-lg text-ink;
  }
</style>
