---
import { education as educationData } from "@/data/education";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);

const education = educationData.map(({ id, year, institution }) => ({
  year,
  degree: t.education.degrees[id],
  institution,
}));
---

<section id="education" class="education" aria-labelledby="education-title">
  <div class="education__intro reveal">
    <h2 id="education-title" class="education__title section-title">
      {t.education.title}
    </h2>
    <p class="education__description">{t.education.description}</p>
  </div>

  <div class="education__list">
    {
      education.map(({ year, degree, institution }, index) => (
        <div class="education__group reveal" style={`--reveal-step:${index}`}>
          <span class="education__group-title">{year}</span>
          <h3 class="education__group-description">{degree}</h3>
          <small>{institution}</small>
        </div>
      ))
    }
  </div>
</section>

<style>
  @reference "@/styles/global.css";

  .education {
    @apply flex flex-col justify-center w-full;
    @apply scroll-mt-20;
  }
  .education__intro {
    @apply flex flex-col items-start gap-4 max-w-2xl;
  }
  .education__title {
    @apply text-3xl sm:text-4xl font-bold text-ink;
  }
  .education__description {
    @apply text-base sm:text-lg text-ink;
  }
  .education__list {
    @apply grid grid-cols-1 gap-8;
    @apply sm:grid-cols-2 md:grid-cols-3;
    @apply mt-8;
  }
  .education__group {
    @apply flex flex-col gap-3;
    @apply border-t border-solid border-rule pt-4;
  }
  .education__group-title {
    @apply text-sm font-bold uppercase text-brand;
  }
  .education__group-description {
    @apply font-bold text-lg text-ink;
  }
</style>
