---
const education = [
  {
    year: "2023 - 2024",
    degree: "Máster de Desarrollo Web y Aplicaciones",
    institution: "Universidad Europea de Madrid",
  },
  {
    year: "2019 - 2023",
    degree: "Grado de Diseño y Creación Digital",
    institution: "Universitat Oberta de Catalunya",
  },
  {
    year: "2017 - 2018",
    degree: "Ciclo Superior Desarrollo Aplicaciones Web",
    institution: "CIFP Villa de Agüimes",
  },

];
---

<section id="education" class="education" aria-labelledby="education-title">
  <div class="education__intro">
    <h2 id="education-title" class="education__title">Education</h2>
    <p class="education__description">
      Lorem ipsum dolor sit, amet consectetur adipisicing elit. Harum qui, eos
      eius iusto unde quis deleniti soluta impedit corrupti non magni voluptatem
      obcaecati, cumque, sint natus iste amet voluptas error?
    </p>
  </div>

  <div class="education__list">
    {
      education.map(({ year, degree, institution }) => (
        <div class="education__group">
          <span class="education__group-title">{year}</span>
          <h3 class="education__group-description">{degree}</h3>
          <small>{institution}</small>
        </div>
      ))
    }
  </div>
</section>

<style>
  @reference "@/styles/global.css";

  .education {
    @apply flex flex-col justify-center w-full;
    @apply scroll-mt-20;
  }
  .education__intro {
    @apply flex flex-col items-start gap-4 max-w-2xl;
  }
  .education__title {
    @apply text-4xl font-bold text-ink;
  }
  .education__description {
    @apply text-lg text-ink;
  }
  .education__list {
    @apply grid grid-cols-1 gap-8;
    @apply md:grid-cols-3;
    @apply mt-8;
  }
  .education__group {
    @apply flex flex-col gap-3;
    @apply border-t border-solid border-rule pt-4;
  }
  .education__group-title {
    @apply text-sm font-bold uppercase text-brand;
  }
  .education__group-description  {
    @apply font-bold text-lg text-ink;
  }
</style>
