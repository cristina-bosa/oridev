---
import { ArrowUpRight } from "@lucide/astro";

import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);

const socials = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/cristina-bosa/",
    icon: ArrowUpRight,
  },
  {
    name: "GitHub",
    url: "https://github.com/cristina-bosa",
    icon: ArrowUpRight,
  },
];
---

<section class="hero">
  <div class="hero__content">
    <h1 class="hero__title">Cristina Bosa</h1>
    <p class="hero__description">{t.hero.description}</p>
  </div>
  <div class="hero__info">
    <div class="hero__actions">
      <p class="hero__availability">{t.hero.availability}</p>
      <div class="hero__links">
        {
          socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label={social.name}
            >
              <social.icon stroke-width={1.5} aria-hidden="true" />
              {social.name}
            </a>
          ))
        }
      </div>
    </div>
    <dl class="hero__personal">
      {
        t.hero.details.map(({ term, value }) => (
          <Fragment>
            <dt class="hero__personal__term">{term}</dt>
            <dd class="hero__personal__value">{value}</dd>
          </Fragment>
        ))
      }
    </dl>
  </div>
</section>

<style>
  @reference "@/styles/global.css";

  .hero {
    @apply flex flex-col items-start w-full;
    @apply min-h-screen justify-start gap-12 pt-24 pb-16;
    @apply md:justify-around md:gap-0 md:py-0;
    @apply relative;
  }
  .hero::before {
    @apply content-[''];
    @apply absolute w-128.25 h-128.25 max-w-full;
    @apply bg-accent-200;
    @apply rounded-full;
    top: 0;
    right: 0;
    filter: blur(900px);
  }

  .hero__content {
    @apply flex flex-col items-start justify-center w-full max-w-2xl gap-4;
  }
  .hero__title {
    @apply text-4xl sm:text-5xl font-black text-ink;
    @apply text-left;
    @apply max-w-2xl;
  }
  .hero__description {
    @apply text-base sm:text-lg text-ink;
    @apply text-left;
    @apply max-w-2xl;
  }
  .hero__info {
    @apply flex flex-col items-start justify-between w-full gap-10;
    @apply md:flex-row md:gap-6;
  }
  .hero__actions {
    @apply flex flex-col items-start justify-between w-full max-w-2xl gap-6;
    @apply mt-4 md:gap-0;
  }
  .hero__links {
    @apply flex flex-wrap items-center justify-start gap-4;
  }
  .hero__links a {
    @apply text-ink;
    @apply hover:text-brand;
    @apply flex items-center gap-2;
    @apply transition-transform duration-200;
  }
  .hero__links a:hover {
    translate: 0 -2px;
  }
  .hero__availability {
    @apply text-ink;
    @apply text-left;
    @apply max-w-2xl;
    @apply uppercase;
    @apply space-x-2;
    @apply relative;
  }
  .hero__availability::before,
  .hero__availability::after {
    content: "";
    @apply absolute w-2 h-2 bg-accent-200 rounded-full;
    top: 50%;
    left: -1rem;
    translate: 0 -50%;
  }

  .hero__availability::after {
    animation: availability-pulse 2s ease-out infinite;
  }

  @keyframes availability-pulse {
    from {
      scale: 1;
      opacity: 0.6;
    }
    to {
      scale: 3.5;
      opacity: 0;
    }
  }

  .hero__personal {
    @apply grid gap-x-4 gap-y-2 md:gap-x-6;
    grid-template-columns: auto minmax(0, 1fr);
  }
  .hero__personal__term {
    @apply text-right uppercase text-sm text-ink font-bold;
  }
  .hero__personal__value {
    @apply text-sm text-ink-muted;
  }

  /* ── Entrada ─────────────────────────────────────────────────
     Por tiempo y no por scroll: el hero ya está en pantalla al cargar,
     así que una timeline `view()` lo pillaría con el rango agotado y
     no se vería nada. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__title,
    .hero__description,
    .hero__availability,
    .hero__links,
    .hero__personal {
      animation: hero-in 0.7s cubic-bezier(0.2, 0.7, 0.3, 1) both;
    }
    .hero__description {
      animation-delay: 80ms;
    }
    .hero__availability {
      animation-delay: 160ms;
    }
    .hero__links {
      animation-delay: 240ms;
    }
    .hero__personal {
      animation-delay: 320ms;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
