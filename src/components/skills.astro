---
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<section id="skills" class="skills" aria-labelledby="skills-title">
  <div class="skills__intro">
    <h2 id="skills-title" class="skills__title">{t.skills.title}</h2>
  </div>

  <div class="skills__list">
    {
      t.skills.groups.map(({ title, items }) => (
        <div class="skills__group">
          <h3 class="skills__group-title">{title}</h3>
          <ul class="skills__group-items">
            {items.map((skill) => (
              <li class="skills__item">{skill}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  @reference "@/styles/global.css";

  .skills {
    @apply flex flex-col justify-center w-full;
    @apply scroll-mt-20;
  }
  .skills__intro {
    @apply flex flex-col items-start gap-4 max-w-2xl;
  }
  .skills__title {
    @apply text-3xl sm:text-4xl font-bold text-ink;
  }
  .skills__description {
    @apply text-base sm:text-lg text-ink;
  }
  .skills__list {
    @apply grid grid-cols-1 gap-8;
    @apply sm:grid-cols-2 md:grid-cols-3;
    @apply mt-8;
  }
  .skills__group {
    @apply flex flex-col gap-3;
    @apply border-t border-solid border-rule pt-4;
  }
  .skills__group-title {
    @apply text-sm font-bold uppercase text-brand;
  }
  .skills__group-items {
    @apply flex flex-col gap-2;
  }
  .skills__item {
    @apply text-ink;
  }
</style>
