---
import { ArrowDownRight } from "@lucide/astro";

import { experiences as experiencesData } from "@/data/experience";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);

const experiences = experiencesData.map(({ id, company, role, from, to }) => ({
  years: `${from} - ${to ?? t.experience.present}`,
  title: t.experience.roles[role],
  company,
  description: t.experience.descriptions[id],
}));
---

<section id="experience" class="experiences" aria-labelledby="experience-title">
  <div class="experiences__intro">
    <h2 id="experience-title" class="experiences__title">
      {t.experience.title}
    </h2>
  </div>
  <div class="experiences__list">
    {
      experiences.map((experience) => (
        <details class="experiences__item">
          <summary class="experiences__item-summary">
            <span class="experiences__item-years">{experience.years}</span>
            <h3 class="experiences__item-title">{experience.title}</h3>
            <span class="experiences__item-company">{experience.company}</span>
            <ArrowDownRight
              class="experiences__item-icon"
              size={20}
              stroke-width={1.5}
              aria-hidden="true"
            />
          </summary>
          <div class="experiences__item-description">
            <p>{experience.description}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  @reference "@/styles/global.css";

  .experiences {
    @apply flex flex-col justify-center w-full;
    @apply scroll-mt-20;
  }
  .experiences__intro {
    @apply flex flex-col items-start gap-4 max-w-2xl;
  }
  .experiences__title {
    @apply text-3xl sm:text-4xl font-bold text-ink;
  }
  .experiences__description {
    @apply text-lg text-ink;
  }
  .experiences__list {
    @apply flex flex-col mt-8;
  }
  .experiences__item {
    @apply border-b border-solid border-ink;
  }
  .experiences__item:last-child {
    @apply border-b-0;
  }
  .experiences__item-summary {
    @apply grid items-center gap-x-4 gap-y-1 p-4 cursor-pointer;
    @apply transition-colors duration-200;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "years icon"
      "title title"
      "company company";
    list-style: none;
  }

  @media (width >= 48rem) {
    .experiences__item-summary {
      @apply items-center;
      grid-template-columns: 8rem auto 1fr auto;
      grid-template-areas: "years title company icon";
    }
  }
  .experiences__item-summary::-webkit-details-marker {
    display: none;
  }

  .experiences__item-icon {
    @apply shrink-0 text-ink;
    @apply transition-transform duration-200;
    grid-area: icon;
    justify-self: end;
  }

  .experiences__item[open] > .experiences__item-summary {
    @apply bg-highlight;
  }

  .experiences__item[open]
    > .experiences__item-summary
    .experiences__item-icon {
    rotate: -90deg;
  }

  .experiences__item-description {
    @apply px-4 pb-4 text-ink-muted py-4;
  }

  @media (prefers-reduced-motion: reduce) {
    .experiences__item-summary,
    .experiences__item-icon {
      transition: none;
    }
  }
  /* La columna de 8rem de la rejilla ya alinea todos los puestos en la
     misma x, así que aquí no hace falta ancho fijo. */
  .experiences__item-years {
    @apply text-sm text-ink;
    grid-area: years;
  }
  .experiences__item-title {
    @apply text-base sm:text-lg font-bold text-ink;
    grid-area: title;
  }
  .experiences__item-company {
    @apply text-base sm:text-lg text-ink;
    grid-area: company;
  }
</style>
