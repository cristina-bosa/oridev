---
import { ArrowDownRight } from "@lucide/astro";

const experiences = [
  {
    years:"2024 - present",
    title: "Front-end tech lead & UX/UI designer",
    company: "DLTCode",    
    description: 
      "Dirección técnica del equipo de front-end y diseño de la empresa, establecimiento buenas prácticas y estándares de desarrollo. Creación del sistema de diseño bajo la marca corporativa. Desarrollo de múltiples productos SaaS bajo tecnologías modernas como NextJS. Implementación y cumplimiento de estándares de accesibilidad WCAG 2.1 AA y optimización de rendimiento web.",    
  },
  {
    years:"2022 - present",
    title: "Front-end developer & UX/UI designer",
    company: "Freelance",    
    description:
      "Diseño y desarrollo de productos web y móviles para clientes. Creación de sistemas de diseño, wireframe de baja y alta fidelidad, prototipado y diseño de interfaz de usuario.",
  },
    {
    years:"2024 - 2024",
    title: "Graphic designer & UX/UI designer",
    company: "DR2U",    
    description:
      "Sistema de diseño bajo la marca corporativa existente. Realización de wireframe de baja y alta fidelidad, prototipado y diseño de interfaz de usuario. Desarrollo de la aplicación híbrida bajo Expo + React Native.",    
  },
  {
    years:"2021 - 2023",
    title: "Graphic designer & UX/UI designer",
    company: "Asista",    
    description:
      "Desarrollo manual de marca, creación de aplicaciones offline y online, wireframe de baja y alta fidelidad, cartelería interna. Accesibilidad WCAG 2.1 AA, diseño de interfaz de usuario y experiencia de usuario.",    
  },
  {
    years:"2018 - 2021",
    title: "Web developer",
    company: "Digital Art & Designers",    
    description:
      "Configurar y gestionar el CMS WordPress bajo los requerimientos de proyecto y cliente. Creación de temas y plugins personalizados, optimización de rendimiento y seguridad. Desarrollo de sitios web responsivos y accesibles.",
  }
  
];
---

<section id="experience" class="experiences" aria-labelledby="experience-title">
  <div class="experiences__intro">
    <h2 id="experience-title" class="experiences__title">Experience</h2>
    <p class="experiences__description">
      Lorem ipsum dolor sit, amet consectetur adipisicing elit. Harum qui, eos
      eius iusto unde quis deleniti soluta impedit corrupti non magni voluptatem
      obcaecati, cumque, sint natus iste amet voluptas error?
    </p>
  </div>
  <div class="experiences__list">
    {experiences.map((experience) => (
      <details class="experiences__item">
        <summary class="experiences__item-summary">
            <span class="experiences__item-years">{experience.years}</span>
            <h3 class="experiences__item-title">{experience.title}</h3> 
            <span class="experiences__item-company">{experience.company}</span>
            <ArrowDownRight
              class="experiences__item-icon"
              size={20}
              stroke-width={1.5}
              aria-hidden="true"
            />
          </summary>
          <div class="experiences__item-description">
            <p>{experience.description}</p>

          </div>

      </details>
    ))}
    </div>


</section>

<style>
  @reference "@/styles/global.css";

  .experiences {
    @apply flex flex-col justify-center w-full;
    @apply scroll-mt-20;
  }
  .experiences__intro {
    @apply flex flex-col items-start gap-4 max-w-2xl;
  }
  .experiences__title {
    @apply text-4xl font-bold text-ink;
  }
  .experiences__description {
    @apply text-lg text-ink;
  }
  .experiences__list {
    @apply flex flex-col mt-8;
  }
  .experiences__item {
    @apply border-b border-solid border-ink;
  }
  .experiences__item:last-child {
    @apply border-b-0;
  }
  .experiences__item-summary {
    @apply flex flex-row items-center gap-4 p-4 cursor-pointer;
    @apply transition-colors duration-200;
    list-style: none;
  }
  .experiences__item-summary::-webkit-details-marker {
    display: none;
  }

  .experiences__item-icon {
    @apply ml-auto shrink-0 text-ink;
    @apply transition-transform duration-200;
  }

  
  .experiences__item[open] > .experiences__item-summary {
    @apply bg-highlight;
  }
  
  .experiences__item[open] > .experiences__item-summary .experiences__item-icon {
    rotate: -90deg;
  }

  .experiences__item-description {
    @apply px-4 pb-4 text-ink-muted py-4;
  }

  @media (prefers-reduced-motion: reduce) {
    .experiences__item-summary,
    .experiences__item-icon {
      transition: none;
    }
  }
  .experiences__item-years {
    @apply text-sm text-ink;
    /* Ancho fijo para que todos los puestos empiecen en la misma x.
       `shrink-0` es imprescindible: sin él flex lo comprime igual
       cuando la fila se queda corta y se pierde la alineación. */
    @apply w-32 shrink-0;
  }
  .experiences__item-title {
    @apply text-lg font-bold text-ink;
  }
  .experiences__item-company {
    @apply text-lg text-ink;
  }


 
</style>
