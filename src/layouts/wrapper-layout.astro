---
import "@/styles/global.css";
import Header from "@/components/navigation/header.astro";
import Footer from "@/components/navigation/footer.astro";
import Head from "@/components/seo/head.astro";
import { getLang } from "@/i18n";

const lang = getLang(Astro.currentLocale);
---

<html lang={lang}>
  <Head />
  <body class="body">
    <Header />
    <main class="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  @reference "@/styles/global.css";

  /* El padding vive aquí y no en el slot: `<slot class="...">` no traslada
     atributos al contenido, así que la antigua regla `.content` era CSS
     muerto y las secciones salían pegadas al borde.
     Desde `md` el padding supera los 4rem de los filetes del body para que
     nunca corten el texto, pase lo que pase con el ancho del container. */
  .main {
    @apply flex flex-col items-center justify-center min-h-screen;
    @apply gap-16 md:gap-24;
    @apply container mx-auto;
    @apply px-5 md:px-20;
    @apply relative;
  }
  .body {
    position: relative;
    width: 100%;
    /* `clip` y no `hidden`: hidden forzaría overflow-y a auto, el body
       pasaría a ser contenedor de scroll y rompería el header sticky.
       Absorbe el ancho de barra que se lleva el 100vw del carrusel. */
    overflow-x: clip;
  }
  /* Filetes decorativos: por debajo de `md` no hay 4rem que gastar a cada
     lado sin comerse el contenido, así que ahí no se pintan. */
  .body::before,
  .body::after {
    content: "";
    position: absolute;
    display: none;
    width: 1px;
    height: 100%;
    background-color: var(--color-rule);
    top: 0;
    z-index: 2;
  }
  .body::before {
    left: 4rem;
  }
  .body::after {
    right: 4rem;
  }

  @media (width >= 48rem) {
    .body::before,
    .body::after {
      display: block;
    }
  }
</style>
